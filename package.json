{
  "name": "elmstead",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p viewer",
    "test": "vitest run",
    "test:fast": "vitest run --exclude tests/cli.test.ts --exclude tests/ifc.test.ts --exclude tests/toolchain.test.ts --exclude tests/snapshot.test.ts --exclude tests/plan-vs-3d.test.ts --exclude tests/viewer-presentation.test.ts --exclude tests/viewer-storey-keys.test.ts --exclude tests/viewer-measure.test.ts --exclude tests/viewer-identify.test.ts --exclude tests/viewer-revisions.test.ts --exclude tests/viewer-diff-mode.test.ts",
    "schema": "tsx scripts/export-json-schema.ts",
    "build": "tsx src/cli/index.ts build",
    "render": "tsx src/cli/index.ts render",
    "check": "tsx src/cli/index.ts check",
    "all": "tsx src/cli/index.ts all",
    "view": "vite --config viewer/vite.config.ts --open"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "dejavu-fonts-ttf": "2.37.3",
    "web-ifc": "0.0.80",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.1.1",
    "@playwright/browser-chromium": "1.65.1",
    "@thatopen/components": "3.6.0",
    "@thatopen/fragments": "3.6.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "camera-controls": "3.1.2",
    "playwright": "1.65.1",
    "polygon-clipping": "0.15.7",
    "three": "0.187.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
