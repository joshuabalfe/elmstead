{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "site": {
      "$ref": "#/$defs/Site"
    },
    "building": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "components": {
      "$ref": "#/$defs/Components"
    },
    "storeys": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/Storey"
      }
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "site",
    "building",
    "storeys"
  ],
  "additionalProperties": false,
  "$defs": {
    "Site": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "northAngle": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "Components": {
      "type": "object",
      "properties": {
        "doors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DoorComponent"
          }
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WindowComponent"
          }
        }
      },
      "required": [
        "doors",
        "windows"
      ],
      "additionalProperties": false
    },
    "DoorComponent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "Frame": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width"
      ],
      "additionalProperties": false
    },
    "WindowComponent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "glazing": {
          "$ref": "#/$defs/Glazing"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "Glazing": {
      "type": "object",
      "properties": {
        "columns": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "rows": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "barWidth": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "columns",
        "rows",
        "barWidth"
      ],
      "additionalProperties": false
    },
    "Storey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "elevation": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "walls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Wall"
          }
        },
        "openings": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/Door"
              },
              {
                "$ref": "#/$defs/Window"
              }
            ]
          }
        },
        "slabs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Slab"
          }
        },
        "rooms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Room"
          }
        },
        "stairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stair"
          }
        },
        "railings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Railing"
          }
        }
      },
      "required": [
        "id",
        "name",
        "elevation",
        "walls",
        "openings",
        "slabs",
        "rooms"
      ],
      "additionalProperties": false
    },
    "Wall": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/Point"
        },
        "end": {
          "$ref": "#/$defs/Point"
        },
        "thickness": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "profile": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "along": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "up": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "along",
              "up"
            ],
            "additionalProperties": false
          }
        },
        "justification": {
          "type": "string",
          "enum": [
            "centre",
            "left",
            "right"
          ]
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "thickness",
        "justification"
      ],
      "additionalProperties": false
    },
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "y": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "Door": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "door"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "wallId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "componentId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "offsetAlongWall": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sillHeight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "swing": {
          "$ref": "#/$defs/Swing"
        },
        "doorway": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "id",
        "wallId",
        "offsetAlongWall",
        "width",
        "height",
        "sillHeight"
      ],
      "additionalProperties": false
    },
    "Swing": {
      "type": "object",
      "properties": {
        "hinge": {
          "type": "string",
          "enum": [
            "start",
            "end"
          ]
        },
        "side": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        }
      },
      "required": [
        "hinge",
        "side"
      ],
      "additionalProperties": false
    },
    "Window": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "window"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "wallId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "componentId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "offsetAlongWall": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sillHeight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reveal": {
          "$ref": "#/$defs/Reveal"
        }
      },
      "required": [
        "kind",
        "id",
        "wallId",
        "offsetAlongWall",
        "width",
        "height",
        "sillHeight"
      ],
      "additionalProperties": false
    },
    "Reveal": {
      "type": "object",
      "properties": {
        "face": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "angle": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 90
        }
      },
      "required": [
        "face",
        "angle"
      ],
      "additionalProperties": false
    },
    "Slab": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "outline": {
          "minItems": 3,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          }
        },
        "thickness": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "elevationOffset": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "material": {
          "type": "string",
          "enum": [
            "concrete",
            "ground"
          ]
        }
      },
      "required": [
        "id",
        "outline",
        "thickness",
        "elevationOffset"
      ],
      "additionalProperties": false
    },
    "Room": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "outline": {
          "minItems": 3,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          }
        },
        "dimensionOutline": {
          "minItems": 3,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          }
        }
      },
      "required": [
        "id",
        "name",
        "outline"
      ],
      "additionalProperties": false
    },
    "Stair": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "toStoreyId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "segments": {
          "minItems": 1,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/StairFlight"
              },
              {
                "$ref": "#/$defs/StairLanding"
              }
            ]
          }
        }
      },
      "required": [
        "id",
        "toStoreyId",
        "segments"
      ],
      "additionalProperties": false
    },
    "StairFlight": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "flight"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "start": {
          "$ref": "#/$defs/Point"
        },
        "end": {
          "$ref": "#/$defs/Point"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "risers": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "id",
        "start",
        "end",
        "width",
        "risers"
      ],
      "additionalProperties": false
    },
    "StairLanding": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "landing"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "outline": {
          "minItems": 3,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          }
        },
        "thickness": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "id",
        "outline",
        "thickness"
      ],
      "additionalProperties": false
    },
    "Railing": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/Point"
        },
        "end": {
          "$ref": "#/$defs/Point"
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "startBase": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endBase": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "height"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://github.com/joshuabalfe/elmstead/schema/building.schema.json",
  "title": "Elmstead building model"
}
